<Window
    x:Class="Zoo_forvaltningssystem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid x:ConnectionId='2' x:Name="RootGrid">
        <Grid Padding="16,16,16,0" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:ConnectionId='3' Grid.Row="0" Grid.Column="1" x:Name="SelectAnimalLabel" Text="Vælg dyr:" />

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                    <Button x:ConnectionId='5'
                        x:Name="RegisterAnimalButton"
                        Content="Opret dyr"
                                                          
                        HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <ComboBox x:ConnectionId='4'
                        x:Name="SelectAnimalBox"
                        HorizontalAlignment="Stretch"
                                                                            />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

